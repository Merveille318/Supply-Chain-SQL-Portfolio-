-- Exercice 1 : Valorisation financière du stock par entrepôt
SELECT 
    s.entrepot_id,
    SUM(s.quantite_stock * p.prix_unitaire) AS valeur_totale_stock
FROM stocks s
INNER JOIN produits p ON s.produit_id = p.produit_id
GROUP BY s.entrepot_id;

-- Exercice 2 : Détection des risques de rupture de stock
SELECT 
    p.produit_id,
    p.libelle_article,
    s.entrepot_id,
    s.quantite_stock,
    p.seuil_alerte,
    CASE 
        WHEN s.quantite_stock <= p.seuil_alerte THEN 'Critique - Risque de rupture'
        ELSE 'Stock Sécurisé'
    END AS statut_risque
FROM produits p
INNER JOIN stocks s ON p.produit_id = s.produit_id;

-- Exercice 3 : Suivi des commandes en cours ou livrées
SELECT 
    commande_id,
    fournisseur_id,
    produit_id,
    date_commande,
    statut
FROM commandes_fournisseurs
WHERE statut IN ('En_cours', 'Livre')
ORDER BY date_commande DESC;

-- Exercice 4 : Analyse de la performance fournisseurs (Lead Time & Retards)
SELECT 
    commande_id,
    fournisseur_id,
    date_reception_prevue,
    date_reception_reelle,
    (date_reception_reelle - date_reception_prevue) AS retard_jours
FROM commandes_fournisseurs
WHERE date_reception_reelle IS NOT NULL
  AND date_reception_reelle > date_reception_prevue;

-- Exercice 5 : Top 5 des produits les plus commandés en volume
SELECT 
    p.libelle_article,
    SUM(c.quantite_commandee) AS total_commande
FROM commandes_fournisseurs c
INNER JOIN produits p ON c.produit_id = p.produit_id
GROUP BY p.libelle_article
ORDER BY total_commande DESC
LIMIT 5;

-- Exercice 6 : Calcul de la part des coûts d'achats par fournisseur
SELECT 
    f.nom_fournisseur,
    SUM(c.quantite_commandee * p.prix_unitaire) AS montant_total_achats
FROM commandes_fournisseurs c
INNER JOIN fournisseurs f ON c.fournisseur_id = f.fournisseur_id
INNER JOIN produits p ON c.produit_id = p.produit_id
GROUP BY f.nom_fournisseur
ORDER BY montant_total_achats DESC;

-- Exercice 7 : Évaluation du taux de service global (OTIF simplifié)
SELECT 
    COUNT(*) AS total_commandes,
    SUM(CASE WHEN date_reception_reelle <= date_reception_prevue THEN 1 ELSE 0 END) AS commandes_a_temps,
    ROUND(
        (SUM(CASE WHEN date_reception_reelle <= date_reception_prevue THEN 1 ELSE 0 END) * 100.0) / COUNT(*), 2
    ) AS taux_respect_delais_pourcent
FROM commandes_fournisseurs
WHERE statut = 'Livre';
